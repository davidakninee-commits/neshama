---
import PrintableLayout from '../../layouts/PrintableLayout.astro';
import { loadTehillimIndex } from '../../lib/content/loadTehillim.ts';

const chapters = loadTehillimIndex();
---

<PrintableLayout title="ספר תהילים">
  <p><a href="/">&larr; חזרה לדף הבית</a></p>

  <ul class="chapter-grid">
    {
      chapters.map((c) => (
        <li>
          <a href={`/tehillim/${c.chapter}`}>פרק {c.chapter}</a>
        </li>
      ))
    }
  </ul>
</PrintableLayout>

<style>
  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .chapter-grid a {
    display: block;
    text-align: center;
    padding: 0.5rem;
    border: 1px solid var(--border-light);
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .chapter-grid a:hover {
    border-color: var(--gold-accent);
    color: var(--gold-hover);
  }
</style>
