---
import PrintableLayout from '../../layouts/PrintableLayout.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import { loadTehillimIndex, loadTehillimChapter } from '../../lib/content/loadTehillim.ts';

export function getStaticPaths() {
  return loadTehillimIndex().map((c) => ({ params: { chapter: String(c.chapter) } }));
}

const chapterNum = Number(Astro.params.chapter);
const { verses } = loadTehillimChapter(chapterNum);
const total = loadTehillimIndex().length;
---

<PrintableLayout title={`תהילים פרק ${chapterNum}`}>
  <ol class="verse-list prayer-text">
    {verses.map((v) => <li>{v}</li>)}
  </ol>

  <ChapterNav basePath="/tehillim" current={chapterNum} total={total} />
</PrintableLayout>
