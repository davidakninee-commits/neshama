---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadMishnahIndex } from '../../../lib/content/loadMishnah.ts';

export function getStaticPaths() {
  return loadMishnahIndex().map((t) => ({
    params: { tractate: t.tractateSlug },
    props: { tractateHe: t.tractateHe, chapterCount: t.chapterCount },
  }));
}

const { tractate } = Astro.params;
const { tractateHe, chapterCount } = Astro.props;
const chapters = Array.from({ length: chapterCount }, (_, i) => i + 1);
---

<BaseLayout title={tractateHe}>
  <p class="breadcrumb"><a href="/mishnah">ששה סדרי משנה</a></p>
  <h1>{tractateHe}</h1>

  <ul class="chapter-grid">
    {
      chapters.map((c) => (
        <li>
          <a href={`/mishnah/${tractate}/${c}`}>פרק {c}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .breadcrumb {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .chapter-grid a {
    display: block;
    text-align: center;
    padding: 0.5rem;
    border: 1px solid var(--border-light);
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .chapter-grid a:hover {
    border-color: var(--gold-accent);
    color: var(--gold-hover);
  }
</style>
