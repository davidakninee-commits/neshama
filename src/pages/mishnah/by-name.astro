---
import PrintableLayout from '../../layouts/PrintableLayout.astro';
import { isPlaceholder } from '../../lib/mishnahByName/defaultMapping.ts';
---

<PrintableLayout title="משניות לפי אותיות השם">
  <p><a href="/mishnah">&larr; חזרה לרשימת הסדרים</a></p>

  {
    isPlaceholder && (
      <p class="disclaimer" role="note">
        ⚠️ מיפוי האותיות למשניות שלהלן הוא <strong>טיוטה ראשונית בלבד</strong> וטרם
        אושר הלכתית — כל משנה המוצגת היא משנה אמיתית וקיימת, אך ההתאמה בין האות
        לבין המשנה הספציפית עדיין דורשת בדיקה.
      </p>
    )
  }

  <form id="name-form" class="name-form">
    <label for="name-input">שם הנפטר</label>
    <input
      id="name-input"
      name="name"
      type="text"
      dir="rtl"
      lang="he"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="לדוגמה: דוד"
      required
    />
    <button type="submit">הצג משניות</button>
  </form>

  <div id="results" aria-live="polite"></div>

  <script>
    import { mishnahForName } from '../../lib/mishnahByName/mishnahForName.ts';
    import { renderMishnahResults } from '../../lib/ui/renderMishnahResults.ts';

    const form = document.getElementById('name-form') as HTMLFormElement;
    const results = document.getElementById('results') as HTMLElement;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = new FormData(form).get('name')?.toString() ?? '';
      const matches = mishnahForName(name);
      renderMishnahResults(results, matches);
    });
  </script>
</PrintableLayout>

<style>
  .mishnah-text {
    padding-inline-start: 0;
  }
</style>
