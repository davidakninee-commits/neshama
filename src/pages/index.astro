---
import PrintableLayout from '../layouts/PrintableLayout.astro';
import VirtualCandle from '../components/VirtualCandle.astro';
import HomeGuide from '../components/HomeGuide.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ComfortVerses from '../components/ComfortVerses.astro';
import MourningMilestones from '../components/MourningMilestones.astro';
import { loadTehillimChapter } from '../lib/content/loadTehillim.ts';

const { verses } = loadTehillimChapter(119);
const ps116 = loadTehillimChapter(116);

const comfortVerses = [
  {
    text: 'וְיָשֹׁב הֶעָפָר עַל הָאָרֶץ כְּשֶׁהָיָה, וְהָרוּחַ תָּשׁוּב אֶל הָאֱלֹהִים אֲשֶׁר נְתָנָהּ.',
    reference: 'קהלת יב, ז',
  },
  { text: ps116.verses[14], reference: 'תהלים קטז, טו' },
  {
    text: 'בִּלַּע הַמָּוֶת לָנֶצַח, וּמָחָה אֲדֹנָי ה׳ דִּמְעָה מֵעַל כָּל פָּנִים.',
    reference: 'ישעיהו כה, ח',
  },
];
---

<PrintableLayout>
  <p>הקלידו את שם הנפטר בעברית, ותופיע תהילים קי"ט לפי אותיות השם.</p>

  <HomeGuide />

  <form id="name-form" class="name-form">
    <label for="name-input">שם הנפטר</label>
    <input
      id="name-input"
      name="name"
      type="text"
      dir="rtl"
      lang="he"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="לדוגמה: דוד"
      required
    />
    <button type="submit">הצג תהילים</button>
  </form>

  <div id="results" aria-live="polite"></div>

  <VirtualCandle />

  <FeatureGrid />

  <ComfortVerses verses={comfortVerses} />

  <MourningMilestones />

  {/* Our own bundled Public Domain Tanakh text, not user input — but the
      </script> escape is cheap defensive practice for any inline JSON. */}
  <script
    type="application/json"
    id="ps119-data"
    set:html={JSON.stringify(verses).replace(/<\//g, '<\\/')}
  />

  <script>
    import { versesForName } from '../lib/tehillim119/versesForName.ts';
    import { renderNameResults } from '../lib/ui/renderNameResults.ts';

    const dataEl = document.getElementById('ps119-data');
    const verses119: string[] = JSON.parse(dataEl?.textContent ?? '[]');

    const form = document.getElementById('name-form') as HTMLFormElement;
    const results = document.getElementById('results') as HTMLElement;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = new FormData(form).get('name')?.toString() ?? '';
      const ranges = versesForName(name);
      renderNameResults(results, verses119, ranges);
    });
  </script>
</PrintableLayout>
