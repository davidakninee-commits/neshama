---
import PrintableLayout from '../layouts/PrintableLayout.astro';
---

<PrintableLayout title="חישוב יארצייט">
  <p><a href="/">&larr; חזרה לדף הבית</a></p>
  <p>
    הזינו את תאריך הפטירה הלועזי, ותקבלו את תאריך הפטירה בלוח העברי ואת מועדי
    היארצייט הקרובים.
  </p>

  <form id="yahrzeit-form" class="name-form">
    <div class="field">
      <label for="death-date-input">תאריך הפטירה (לועזי)</label>
      <input id="death-date-input" type="date" required />
    </div>
  </form>

  <div id="yahrzeit-results" aria-live="polite"></div>

  <script>
    import { calculateYahrzeit } from '../lib/yahrzeit/calculateYahrzeit.ts';
    import { renderYahrzeitResults } from '../lib/ui/renderYahrzeitResults.ts';

    const input = document.getElementById('death-date-input') as HTMLInputElement;
    const results = document.getElementById('yahrzeit-results') as HTMLElement;

    // Parses the <input type="date"> value ("YYYY-MM-DD") as a LOCAL date.
    // `new Date("YYYY-MM-DD")` parses as UTC midnight, which off-by-one's to
    // the previous day in any timezone behind UTC - a classic gotcha.
    function parseDateInputValue(value: string): Date | null {
      const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (!match) return null;
      const [, year, month, day] = match;
      return new Date(Number(year), Number(month) - 1, Number(day));
    }

    input.addEventListener('input', () => {
      const deathDate = parseDateInputValue(input.value);
      if (!deathDate) {
        results.replaceChildren();
        return;
      }
      const result = calculateYahrzeit(deathDate, { count: 3 });
      renderYahrzeitResults(results, result);
    });
  </script>
</PrintableLayout>

<style>
  .field label {
    display: block;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .field input {
    font-size: 1.1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-light);
    border-radius: 0.375rem;
    background: var(--bg-surface);
    color: var(--text-primary);
  }

  .yahrzeit-death-date {
    font-size: 1.05rem;
    margin-top: 1.5rem;
  }

  .yahrzeit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .yahrzeit-list li {
    border: 1px solid var(--border-light);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .yahrzeit-hebrew {
    font-size: 1.2rem;
  }

  .yahrzeit-gregorian {
    font-family: var(--font-ui);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .yahrzeit-note {
    flex-basis: 100%;
    margin: 0.5rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--caution-bg);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
  }
</style>
