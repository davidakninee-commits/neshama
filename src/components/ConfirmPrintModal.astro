---
---

<dialog id="print-confirm-dialog" class="print-confirm-dialog">
  <h2>לפני ההדפסה</h2>
  <p>
    הדף מכיל שמות קודש. אין להשליך את הדף המודפס לאשפה — יש לנהוג בו כבוד
    ולמסור אותו לגניזה.
  </p>
  <div class="dialog-actions">
    <button type="button" id="print-confirm-cancel">ביטול</button>
    <button type="button" id="print-confirm-go">הבנתי, הדפסה</button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('print-confirm-dialog') as HTMLDialogElement | null;

  document.getElementById('print-confirm-cancel')?.addEventListener('click', () => {
    dialog?.close();
  });

  document.getElementById('print-confirm-go')?.addEventListener('click', () => {
    dialog?.close();
    window.print();
  });

  // Close on backdrop click.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .print-confirm-dialog {
    border: 1px solid var(--border-light);
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    max-width: 24rem;
    font-family: var(--font-ui);
  }

  .print-confirm-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .print-confirm-dialog h2 {
    margin-top: 0;
    font-size: 1.1rem;
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .dialog-actions button {
    font-size: 0.95rem;
    padding: 0.4rem 1rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-light);
    background: var(--bg-surface);
    color: var(--text-primary);
  }

  #print-confirm-go {
    border-color: var(--primary-accent);
    background: var(--primary-accent);
    color: white;
  }
</style>
