---
---

<section class="memorial-card-share" aria-label="כרטיס זיכרון לשיתוף">
  <h2>כרטיס זיכרון לשיתוף</h2>
  <p class="share-hint">
    אפשר ליצור כרטיס אישי עם נר זיכרון, ולשתף אותו במשפחה ובחברים — רק מי שבוחר/ת בכך. הכרטיס נוצר
    במכשיר שלכם בלבד ואינו נשלח לשום שרת.
  </p>

  <div class="field">
    <label for="memorial-words">מילים אישיות (אופציונלי)</label>
    <input
      id="memorial-words"
      type="text"
      dir="rtl"
      lang="he"
      maxlength="60"
      autocomplete="off"
      placeholder="לדוגמה: אהוב/ה וזכור/ה לנצח"
    />
  </div>

  <button type="button" id="generate-card-button" class="generate-button">יצירת כרטיס זיכרון</button>

  <p class="card-status" id="card-status" role="status" aria-live="polite"></p>

  <canvas id="memorial-canvas" width="1080" height="1080" hidden></canvas>

  <div class="card-preview" id="card-preview"></div>

  <div class="card-actions" id="card-actions" hidden>
    <button type="button" id="share-card-button" hidden>שיתוף</button>
    <a id="download-card-link" download="כרטיס-זיכרון.png">הורדת תמונה</a>
  </div>
</section>

<script>
  import { drawMemorialCard } from '../lib/ui/drawMemorialCard.ts';

  const nameInput = document.getElementById('name-input') as HTMLInputElement | null;
  const wordsInput = document.getElementById('memorial-words') as HTMLInputElement;
  const generateButton = document.getElementById('generate-card-button') as HTMLButtonElement;
  const status = document.getElementById('card-status') as HTMLElement;
  const canvas = document.getElementById('memorial-canvas') as HTMLCanvasElement;
  const preview = document.getElementById('card-preview') as HTMLElement;
  const actions = document.getElementById('card-actions') as HTMLElement;
  const shareButton = document.getElementById('share-card-button') as HTMLButtonElement;
  const downloadLink = document.getElementById('download-card-link') as HTMLAnchorElement;

  let lastDataUrl: string | null = null;

  async function generate() {
    const name = nameInput?.value.trim() ?? '';
    if (!name) {
      status.textContent = 'נא להקליד למעלה את שם הנפטר/ת, ואז ליצור את הכרטיס.';
      return;
    }

    await document.fonts.ready;
    drawMemorialCard(canvas, { name, words: wordsInput.value.trim() });
    const dataUrl = canvas.toDataURL('image/png');
    lastDataUrl = dataUrl;

    preview.replaceChildren();
    const img = document.createElement('img');
    img.src = dataUrl;
    img.alt = `כרטיס זיכרון: לעילוי נשמת ${name}`;
    // אנימציית @keyframes (לא transition+rAF) - רצה אוטומטית ברגע שהאלמנט
    // נוסף ל-DOM, בלי תלות ב-requestAnimationFrame שמוקפא בטאבים ברקע.
    img.className = 'card-reveal';
    preview.appendChild(img);

    downloadLink.href = dataUrl;
    shareButton.hidden = !('share' in navigator);
    actions.hidden = false;
    status.textContent = 'הכרטיס מוכן. השיתוף וההורדה הם בחירה שלכם בלבד.';
  }

  generateButton.addEventListener('click', generate);

  shareButton.addEventListener('click', async () => {
    if (!lastDataUrl || !navigator.share) return;
    try {
      const res = await fetch(lastDataUrl);
      const blob = await res.blob();
      const file = new File([blob], 'כרטיס-זיכרון.png', { type: 'image/png' });
      if ('canShare' in navigator && !navigator.canShare({ files: [file] })) {
        status.textContent = 'השיתוף הישיר לא נתמך בדפדפן הזה — אפשר להוריד את התמונה ולשתף ידנית.';
        return;
      }
      await navigator.share({ files: [file], title: 'כרטיס זיכרון' });
    } catch (err) {
      if (err instanceof Error && err.name !== 'AbortError') {
        status.textContent = 'השיתוף לא הושלם — אפשר להוריד את התמונה ולשתף ידנית.';
      }
    }
  });
</script>

<style>
  .memorial-card-share {
    margin: 2.5rem 0;
  }

  .memorial-card-share h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .share-hint {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }

  .field label {
    display: block;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .field input {
    font-size: 1rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border-light);
    border-radius: 0.375rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    width: 100%;
    max-width: 22rem;
  }

  .generate-button {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 500;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--primary-accent);
    border-radius: 0.375rem;
    background: var(--primary-accent);
    color: white;
    transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), background-color 150ms ease, border-color 150ms ease;
  }

  .generate-button:hover {
    background: var(--gold-hover);
    border-color: var(--gold-hover);
  }

  .generate-button:active {
    transform: scale(0.96);
  }

  .card-status {
    font-size: 0.85rem;
    color: var(--gold-hover);
    min-height: 1.2em;
    margin: 0.6rem 0 0;
  }

  /* :global — this <img> is inserted client-side (not present at build
     time), so Astro's scoped-style attribute never reaches it. */
  .card-preview :global(img) {
    display: block;
    max-width: 18rem;
    width: 100%;
    margin: 1rem 0;
    border-radius: 0.5rem;
  }

  /* "התממשות" של הכרטיס - נפח+שקיפות יחד, לא הופעה מיידית. אנימציית
     @keyframes (לא transition+toggle) כדי שתרוץ אוטומטית ברגע ההוספה
     ל-DOM, בלי תלות ב-requestAnimationFrame. */
  .card-preview :global(img.card-reveal) {
    animation: card-materialize 400ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes card-materialize {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-preview :global(img.card-reveal) {
      animation: card-materialize-fade 200ms ease both;
    }
  }

  @keyframes card-materialize-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .card-actions {
    display: flex;
    gap: 0.75rem;
  }

  .card-actions button,
  .card-actions a {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-light);
    background: var(--bg-surface);
    color: var(--text-primary);
    transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), border-color 150ms ease, color 150ms ease;
  }

  .card-actions button:active,
  .card-actions a:active {
    transform: scale(0.95);
  }

  .card-actions button:hover,
  .card-actions a:hover {
    border-color: var(--gold-accent);
    color: var(--gold-hover);
  }
</style>
