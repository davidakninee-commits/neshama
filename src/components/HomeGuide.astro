---
const steps = [
  { badge: 'א', text: 'הקלידו את שם הנפטר/ת בעברית, בתיבה שלמטה.' },
  {
    badge: 'ב',
    text: 'יופיעו פסוקי תהילים קי"ט לפי אותיות השם — ואפשר גם לעיין במשניות, בהזכרה, בקדיש ובחישוב היארצייט שבתפריט.',
  },
  { badge: 'ג', text: 'אפשר להדליק נר לעילוי הנשמה, ולהדפיס להנצחה (עם אזהרת גניזה, בשל שמות הקודש שבתוכן).' },
];
---

<section class="home-guide" aria-label="איך זה עובד">
  <h2>איך זה עובד</h2>
  <ol>
    {
      steps.map((step) => (
        <li>
          <span class="letter-badge" aria-hidden="true">
            {step.badge}
          </span>
          <span class="step-text">{step.text}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .home-guide {
    margin: 2rem 0;
  }

  .home-guide h2 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .home-guide ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .home-guide li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .step-text {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
