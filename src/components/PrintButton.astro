<button type="button" id="print-trigger" class="print-trigger">הדפסה</button>

<script>
  document.getElementById('print-trigger')?.addEventListener('click', () => {
    const dialog = document.getElementById('print-confirm-dialog') as HTMLDialogElement | null;
    dialog?.showModal();
  });
</script>

<style>
  .print-trigger {
    font-size: 0.9rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-light);
    border-radius: 0.375rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), border-color 150ms ease, color 150ms ease;
  }

  .print-trigger:hover {
    border-color: var(--gold-accent);
    color: var(--gold-hover);
  }

  .print-trigger:active {
    transform: scale(0.96);
  }
</style>
