---
interface Props {
  /** base path, e.g. "/tehillim" or "/mishnah/berakhot" */
  basePath: string;
  current: number;
  total: number;
}

const { basePath, current, total } = Astro.props;
const prev = current > 1 ? current - 1 : null;
const next = current < total ? current + 1 : null;
---

<nav class="chapter-nav">
  {prev ? <a href={`${basePath}/${prev}`}>&rarr; פרק {prev}</a> : <span />}
  <a href={basePath}>רשימת פרקים</a>
  {next ? <a href={`${basePath}/${next}`}>פרק {next} &larr;</a> : <span />}
</nav>

<style>
  .chapter-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0 1rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }
</style>
